# Response headers for Cloudflare Pages (this file is read by Pages, not served).
# The pages also carry a <meta> Content-Security-Policy; frame-ancestors only
# works as a real header, so it lives here: nobody can embed the join page in
# a frame to trick guests into clicking (clickjacking).

/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=()

# versioned file (peerjs@x.y.z): safe to cache for a year
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
